; Quick BNF(-ish?) grammar to help me get my head around the syntax

_alpha : 'a'-'z' | 'A'-'Z' ;
_alnum : _alpha | '0'..'9' ;
_unsigned_number : '0' | '1'..'9' { '0'..'9' } ;
_number : [ '-' ] _unsigned_number ;
field : _alnum | { _alnum | '-' } ;
value : _alnum ;
offset : _number ;
!whitespace : ' ' | '\t' | '\r' | '\n' ;

Strategy : Forest "\\/" Forest ;

Forest : Forest ActionTree
       | empty
       ;

ActionTree : Trigger "-" [ Action ] "-|" ;

Trigger : "[" Proto ":" field ":" value [ ":" gas ] "]" ;

gas : _number ;

Proto : "IP"
      | "ip"
      | "TCP"
      | "tcp"
      ;

Action : Duplicate
       | Fragment
       | Tamper
       | Sleep
       | Drop
       | Send
       | empty
       ;

;;;;;;;;; duplicate rule
Duplicate : "duplicate(" Action "," Action ")" ;

;;;;;;;;; fragment rule
Fragment : "fragment" FragmentRule
         | "fragment" FragmentRule "(" Action "," Action ")"
         ;

FragmentRule : "{" Proto ":" offset ":" InOrder [ ":" overlap ] "}"

overlap : _unsigned_number ;

InOrder : "True"
        | "False"
        ;

;;;;;;;;; tamper rule
Tamper : "tamper" TamperRule
       | "tamper" TamperRule "(" Action "," Action ")"
       ;

TamperRule : "{" Proto ":" field ":" TamperMode "}" ;

TamperMode : Replace
           | Corrupt
           | Add
           ;

Replace : "replace:" value ;

Corrupt : "corrupt" ;

; "add" adds value to a numeric field's current value.
Add : "add:" value ;

;;;;;;;;; sleep rule
; duration is expressed in (fractional) seconds; the child action is optional.
Sleep : "sleep{" seconds "}"
      | "sleep{" seconds "}" "(" Action ")"
      ;

seconds : _unsigned_number [ "." _unsigned_number ] ;

;;;;;;;;; drop rule
Drop : "drop" ;

;;;;;;;;; send rule
Send : "send" ;
